<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Celeris.Net</AssemblyName>
    <!-- Architecture -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    
    <!-- NuGet Package Properties -->
    <PackageId>Celeris.Net</PackageId>
    <Version>0.1.0</Version>
    <Authors>Celeris</Authors>
    <Description>C# bindings and framework for the Celeris engine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundle the native DLLs into the NuGet package and copy them to consuming projects -->
    <Content Include="..\..\..\zig-out\bin\celeris.dll" Link="celeris.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\win-x64\native\" />
    <Content Include="..\..\..\zig-out\bin\wgpu_native.dll" Link="wgpu_native.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\win-x64\native\" />
  </ItemGroup>

</Project>
